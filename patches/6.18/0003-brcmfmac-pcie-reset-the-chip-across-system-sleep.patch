From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Weegee <748975+Weegee@users.noreply.github.com>
Date: Tue, 13 Oct 2026 15:18:40 +0200
Subject: [PATCH] brcmfmac: pcie: reset the chip across system sleep

On the MacBook9,1 (BCM4350/5, firmware 7.35.180.133) the firmware hung
1.6 s after a resume in which the chip had kept power and the driver had
taken the hot-resume path. From then on every firmware command timed
out, brcmf_pcie_pm_enter_D3() never got its D3 acknowledgement, and it
aborted every further system suspend with -EIO: a laptop with a hung
WLAN chip no longer slept. Reloading the module failed because the chip
answered MMIO reads with 0xffffffff; only a reboot recovered it. Resumes
that reloaded the firmware showed no such hang.

New module parameter pm_reset (default on): the suspend and freeze
callbacks remove the device as an unbind would, the resume, thaw and
restore callbacks reset it through its parent bridge (secondary bus
reset, the chip has no FLR) and probe it again. Every resume therefore
starts from the power-on state of the chip, in sleep the chip is held in
reset instead of running firmware, and a missing D3 acknowledgement can
no longer abort system sleep. The probe on the cold-resume path gets the
same reset.

With pm_reset off the hot-resume path stays, but a missing D3
acknowledgement now removes the device instead of aborting the suspend,
and thaw is handled like restore so an aborted hibernation does not leave
the device in D3.
---
 .../broadcom/brcm80211/brcmfmac/pcie.c        | 58 ++++++++++++++++---
 1 file changed, 49 insertions(+), 9 deletions(-)

diff --git a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/pcie.c b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/pcie.c
index dbe2ceb..1b1aece 100644
--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/pcie.c
+++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/pcie.c
@@ -2636,6 +2636,35 @@ brcmf_pcie_remove(struct pci_dev *pdev)
 
 #ifdef CONFIG_PM
 
+/* The firmware of the BCM4350 in the MacBook9,1 can hang after a resume
+ * in which the chip kept power ("hot resume"): every firmware command then
+ * times out, D3 entry is never acknowledged and each further system sleep
+ * is aborted. Resumes in which the firmware was reloaded did not show it.
+ * With pm_reset the device is therefore removed before system sleep and,
+ * on resume, reset through its parent bridge (secondary bus reset) and
+ * probed again, so every resume starts from the power-on state of the chip.
+ */
+static bool brcmf_pcie_pm_reset = true;
+module_param_named(pm_reset, brcmf_pcie_pm_reset, bool, 0644);
+MODULE_PARM_DESC(pm_reset, "Remove the device for system sleep, reset and probe it again on resume [PCIe]");
+
+static int brcmf_pcie_pm_reprobe(struct pci_dev *pdev)
+{
+	int err;
+
+	/* The PM core holds the device lock across the resume callbacks. */
+	err = pci_reset_function_locked(pdev);
+	if (err)
+		pci_info(pdev, "reset before probe failed (%d), probing anyway\n",
+			 err);
+
+	err = brcmf_pcie_probe(pdev, NULL);
+	if (err)
+		__brcmf_err(NULL, __func__, "probe after resume failed, err=%d\n",
+			    err);
+	return err;
+}
+
 
 static int brcmf_pcie_pm_enter_D3(struct device *dev)
 {
@@ -2645,6 +2674,15 @@ static int brcmf_pcie_pm_enter_D3(struct device *dev)
 	brcmf_dbg(PCIE, "Enter\n");
 
 	bus = dev_get_drvdata(dev);
+	if (!bus)
+		return 0;
+
+	if (brcmf_pcie_pm_reset) {
+		brcmf_dbg(PCIE, "removing device for system sleep\n");
+		brcmf_pcie_remove(to_pci_dev(dev));
+		return 0;
+	}
+
 	devinfo = bus->bus_priv.pcie->devinfo;
 
 	brcmf_pcie_fwcon_timer(devinfo, false);
@@ -2656,9 +2694,12 @@ static int brcmf_pcie_pm_enter_D3(struct device *dev)
 	wait_event_timeout(devinfo->mbdata_resp_wait, devinfo->mbdata_completed,
 			   BRCMF_PCIE_MBDATA_TIMEOUT);
 	if (!devinfo->mbdata_completed) {
-		brcmf_err(bus, "Timeout on response for entering D3 substate\n");
-		brcmf_bus_change_state(bus, BRCMF_BUS_UP);
-		return -EIO;
+		/* A hung firmware must not keep the system awake: remove the
+		 * device instead, resume resets and probes it again.
+		 */
+		brcmf_err(bus, "Timeout on response for entering D3 substate, removing device\n");
+		brcmf_pcie_remove(to_pci_dev(dev));
+		return 0;
 	}
 
 	devinfo->state = BRCMFMAC_PCIE_STATE_DOWN;
@@ -2672,11 +2713,13 @@ static int brcmf_pcie_pm_leave_D3(struct device *dev)
 	struct brcmf_pciedev_info *devinfo;
 	struct brcmf_bus *bus;
 	struct pci_dev *pdev;
-	int err;
 
 	brcmf_dbg(PCIE, "Enter\n");
 
 	bus = dev_get_drvdata(dev);
+	if (!bus)
+		return brcmf_pcie_pm_reprobe(to_pci_dev(dev));
+
 	devinfo = bus->bus_priv.pcie->devinfo;
 	brcmf_dbg(PCIE, "Enter, dev=%p, bus=%p\n", dev, bus);
 
@@ -2701,11 +2744,7 @@ cleanup:
 	pdev = devinfo->pdev;
 	brcmf_pcie_remove(pdev);
 
-	err = brcmf_pcie_probe(pdev, NULL);
-	if (err)
-		__brcmf_err(NULL, __func__, "probe after resume failed, err=%d\n", err);
-
-	return err;
+	return brcmf_pcie_pm_reprobe(pdev);
 }
 
 
@@ -2713,6 +2752,7 @@ static const struct dev_pm_ops brcmf_pciedrvr_pm = {
 	.suspend = brcmf_pcie_pm_enter_D3,
 	.resume = brcmf_pcie_pm_leave_D3,
 	.freeze = brcmf_pcie_pm_enter_D3,
+	.thaw = brcmf_pcie_pm_leave_D3,
 	.restore = brcmf_pcie_pm_leave_D3,
 };
 
