From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Weegee <748975+Weegee@users.noreply.github.com>
Date: Tue, 13 Oct 2026 15:20:11 +0200
Subject: [PATCH] brcmfmac: msgbuf: treat repeated command timeouts as a hung
 firmware

When the BCM4350 firmware on the MacBook9,1 hung after a resume it sent
no trap, so brcmf_fw_crashed() never ran: the driver kept sending
commands into a ring nobody consumed, logged 61 command timeouts, 220
'Failed to reserve space in commonring' and a cascade of -EIO and
-ENOMEM errors over minutes, and the interface stayed dead until reboot.

Two consecutive command timeouts (2 s each) now mark the firmware as
unresponsive: further commands fail at once with -EIO and the bus reset
of brcmf_fw_crashed() is scheduled, without its memory dump, which a
hung chip may not serve. Any answered command resets the count, so a
single slow response does not trigger it. The timeout message names the
command.
---
 .../wireless/broadcom/brcm80211/brcmfmac/bus.h    |  1 +
 .../wireless/broadcom/brcm80211/brcmfmac/core.c   | 15 +++++++++++++++
 .../wireless/broadcom/brcm80211/brcmfmac/msgbuf.c | 15 ++++++++++++++-
 3 files changed, 30 insertions(+), 1 deletion(-)

diff --git a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/bus.h b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/bus.h
index b15a0ca..64304f3 100644
--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/bus.h
+++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/bus.h
@@ -315,6 +315,7 @@ void brcmf_dev_reset(struct device *dev);
 void brcmf_dev_coredump(struct device *dev);
 /* Indication that firmware has halted or crashed */
 void brcmf_fw_crashed(struct device *dev);
+void brcmf_fw_unresponsive(struct device *dev);
 
 /* Configure the "global" bus state used by upper layers */
 void brcmf_bus_change_state(struct brcmf_bus *bus, enum brcmf_bus_state state);
diff --git a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/core.c b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/core.c
index 9320158..807f27d 100644
--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/core.c
+++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/core.c
@@ -1445,6 +1445,21 @@ void brcmf_dev_coredump(struct device *dev)
 		brcmf_dbg(TRACE, "failed to create coredump\n");
 }
 
+/* The firmware stopped answering commands without signalling a trap:
+ * recover the same way as from a crash, without a memory dump (a hung
+ * chip may not answer the reads it needs).
+ */
+void brcmf_fw_unresponsive(struct device *dev)
+{
+	struct brcmf_bus *bus_if = dev_get_drvdata(dev);
+
+	if (!bus_if || !bus_if->drvr)
+		return;
+
+	bphy_err(bus_if->drvr, "Firmware does not respond, recovering\n");
+	brcmf_bus_schedule_reset(bus_if);
+}
+
 bool brcmf_err_quiet(struct brcmf_pub *drvr)
 {
 	return drvr && drvr->bus_if && READ_ONCE(drvr->bus_if->quiet);
diff --git a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/msgbuf.c b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/msgbuf.c
index 45fbcbd..f90750e 100644
--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/msgbuf.c
+++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/msgbuf.c
@@ -72,6 +72,10 @@
 #define BRCMF_MSGBUF_UPDATE_RX_PTR_THRS		48
 
 #define BRCMF_MAX_TXSTATUS_WAIT_RETRIES		10
+/* Consecutive command timeouts (2 s each) after which the firmware is
+ * taken as hung and the bus is reset.
+ */
+#define BRCMF_MSGBUF_HUNG_TIMEOUTS		2
 
 struct msgbuf_common_hdr {
 	u8				msgtype;
@@ -260,6 +264,8 @@ struct brcmf_msgbuf {
 	u32 reqid;
 	wait_queue_head_t ioctl_resp_wait;
 	bool ctl_completed;
+	u32 ioctl_timeouts;	/* consecutive, reset by any response */
+	bool fw_unresponsive;	/* recovery requested, fail commands fast */
 
 	struct brcmf_msgbuf_pktids *tx_pktids;
 	struct brcmf_msgbuf_pktids *rx_pktids;
@@ -499,6 +505,8 @@ static int brcmf_msgbuf_query_dcmd(struct brcmf_pub *drvr, int ifidx,
 
 	brcmf_dbg(MSGBUF, "ifidx=%d, cmd=%d, len=%d\n", ifidx, cmd, len);
 	*fwerr = 0;
+	if (msgbuf->fw_unresponsive)
+		return -EIO;
 	msgbuf->ctl_completed = false;
 	err = brcmf_msgbuf_tx_ioctl(drvr, ifidx, cmd, buf, len);
 	if (err)
@@ -506,9 +514,14 @@ static int brcmf_msgbuf_query_dcmd(struct brcmf_pub *drvr, int ifidx,
 
 	timeout = brcmf_msgbuf_ioctl_resp_wait(msgbuf);
 	if (!timeout) {
-		bphy_err(drvr, "Timeout on response for query command\n");
+		bphy_err(drvr, "Timeout on response for query command %u\n", cmd);
+		if (++msgbuf->ioctl_timeouts >= BRCMF_MSGBUF_HUNG_TIMEOUTS) {
+			msgbuf->fw_unresponsive = true;
+			brcmf_fw_unresponsive(drvr->bus_if->dev);
+		}
 		return -EIO;
 	}
+	msgbuf->ioctl_timeouts = 0;
 
 	skb = brcmf_msgbuf_get_pktid(msgbuf->drvr->bus_if->dev,
 				     msgbuf->rx_pktids,
