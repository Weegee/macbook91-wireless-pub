From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Weegee <748975+Weegee@users.noreply.github.com>
Date: Tue, 13 Oct 2026 15:40:07 +0200
Subject: [PATCH] Bluetooth: hci_bcm: clear reserved bits of LE advertising
 types on Macs

The BCM4350C0 UART controller of the MacBook9,1 (ROM build 1532; neither
macOS 12 nor Boot Camp carries a patch for it) sets bits 4 and 5 of the
event type in legacy LE Advertising Reports. In a btmon capture of an LE
scan, 268 of 434 reports had types 0x10, 0x12, 0x13, 0x14, 0x20, 0x22,
0x23 or 0x24; process_adv_report() drops each as 'unknown advertising
packet type', so LE devices are found and reconnected late or not at
all, and the kernel log fills with that error during every scan.

On Macs (Apple ACPI resources found), the event handler of hci_bcm
clears the reserved bits of each report's type when the low three bits
hold a valid legacy type, before the frame reaches the core.

bcm_open() copies the flag from the bcm_device into bcm_data under
bcm_device_lock, so the receive path does not dereference bcm->dev,
which bcm_recv() only touches after checking that the device still
exists.
---
 drivers/bluetooth/hci_bcm.c | 51 ++++++++++++++++++++++++++++++++++++-
 1 file changed, 50 insertions(+), 1 deletion(-)

diff --git a/drivers/bluetooth/hci_bcm.c b/drivers/bluetooth/hci_bcm.c
index 0a54a7c..ebcf147 100644
--- a/drivers/bluetooth/hci_bcm.c
+++ b/drivers/bluetooth/hci_bcm.c
@@ -147,6 +147,7 @@ struct bcm_device {
 	bool			drive_rts_on_open;
 	bool			no_uart_clock_set;
 	bool			use_autobaud_mode;
+	bool			le_adv_type_fixup;
 	u8			pcm_int_params[5];
 	u32			max_autobaud_speed;
 };
@@ -157,6 +158,7 @@ struct bcm_data {
 	struct sk_buff_head	txq;
 
 	struct bcm_device	*dev;
+	bool			le_adv_type_fixup;	/* from dev, see bcm_open() */
 };
 
 /* List of BCM BT UART devices */
@@ -485,6 +487,11 @@ static int bcm_open(struct hci_uart *hu)
 
 out:
 	if (bcm->dev) {
+		/* Copied under bcm_device_lock: the receive path must not
+		 * dereference bcm->dev, see bcm_recv().
+		 */
+		bcm->le_adv_type_fixup = bcm->dev->le_adv_type_fixup;
+
 		if (bcm->dev->use_autobaud_mode)
 			hci_uart_set_flow_control(hu, false);	/* Assert BT_UART_CTS_N */
 		else if (bcm->dev->drive_rts_on_open)
@@ -681,10 +688,51 @@ static int bcm_setup(struct hci_uart *hu)
 	.lsize = 0, \
 	.maxlen = BCM_TYPE52_SIZE
 
+/* The BCM4350C0 UART controller of Intel Macs (ROM build 1532, no patch
+ * for it in macOS or Boot Camp) sets bits 4 and 5 of the event type in
+ * legacy LE Advertising Reports: on the MacBook9,1 268 of 434 reports of a
+ * scan came as 0x10, 0x13, 0x14, 0x20, 0x22, 0x23, 0x24. The core drops
+ * them as 'unknown advertising packet type', so LE devices are found and
+ * reconnected late or not at all. The low three bits carry a valid type;
+ * the reserved upper bits are cleared before the core sees the report.
+ */
+static void bcm_fixup_le_adv_report(struct sk_buff *skb)
+{
+	u8 *d = skb->data;
+	unsigned int len = skb->len, off = 4;
+	u8 num;
+
+	if (len < 4 || d[0] != HCI_EV_LE_META ||
+	    d[2] != HCI_EV_LE_ADVERTISING_REPORT)
+		return;
+
+	/* Each report: type, address type, address[6], data length, data,
+	 * RSSI.
+	 */
+	for (num = d[3]; num && off + 10 <= len; num--) {
+		u8 type = d[off];
+
+		if ((type & ~0x07) && (type & 0x07) <= LE_ADV_SCAN_RSP)
+			d[off] = type & 0x07;
+		off += 10 + d[off + 8];
+	}
+}
+
+static int bcm_recv_event(struct hci_dev *hdev, struct sk_buff *skb)
+{
+	struct hci_uart *hu = hci_get_drvdata(hdev);
+	struct bcm_data *bcm = hu ? hu->priv : NULL;
+
+	if (bcm && bcm->le_adv_type_fixup)
+		bcm_fixup_le_adv_report(skb);
+
+	return hci_recv_frame(hdev, skb);
+}
+
 static const struct h4_recv_pkt bcm_recv_pkts[] = {
 	{ H4_RECV_ACL,      .recv = hci_recv_frame },
 	{ H4_RECV_SCO,      .recv = hci_recv_frame },
-	{ H4_RECV_EVENT,    .recv = hci_recv_frame },
+	{ H4_RECV_EVENT,    .recv = bcm_recv_event },
 	{ H4_RECV_ISO,      .recv = hci_recv_frame },
 	{ BCM_RECV_LM_DIAG, .recv = hci_recv_diag  },
 	{ BCM_RECV_NULL,    .recv = hci_recv_diag  },
@@ -1032,6 +1080,7 @@ static int bcm_apple_get_resources(struct bcm_device *dev)
 
 	dev->set_device_wakeup = bcm_apple_set_device_wakeup;
 	dev->set_shutdown = bcm_apple_set_shutdown;
+	dev->le_adv_type_fixup = true;
 
 	return 0;
 }
