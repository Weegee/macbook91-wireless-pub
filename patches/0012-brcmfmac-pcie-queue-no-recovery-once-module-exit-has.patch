From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Weegee <748975+Weegee@users.noreply.github.com>
Date: Wed, 14 Oct 2026 10:56:08 +0200
Subject: [PATCH] brcmfmac: pcie: queue no recovery once module exit has begun

brcmf_pcie_exit() destroys the recovery queue before it unregisters the
driver, so a firmware hang reported in between by the still bound device
could queue work on a queue that is being drained or already freed: a
workqueue warning and a lost work item holding a device reference, or a
use after free. brcmf_pcie_reset() reads brcmf_pcie_wq without
synchronisation, and the work was queued after the lock was dropped.

Module exit now closes the queue under brcmf_pcie_rebind_lock before it
destroys it, and brcmf_pcie_schedule_rebind() queues under the same lock
and only while the queue is open. The work item is allocated before the
lock is taken.
---
 .../broadcom/brcm80211/brcmfmac/pcie.c        | 44 +++++++++++--------
 1 file changed, 26 insertions(+), 18 deletions(-)

diff --git a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/pcie.c b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/pcie.c
index 6d0175c..68f67ab 100644
--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/pcie.c
+++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/pcie.c
@@ -1572,6 +1572,7 @@ struct brcmf_pcie_rebind {
 static struct workqueue_struct *brcmf_pcie_wq;
 static DEFINE_SPINLOCK(brcmf_pcie_rebind_lock);
 static bool brcmf_pcie_rebind_pending;
+static bool brcmf_pcie_rebind_closed;	/* module exit: queue no recovery */
 static unsigned long brcmf_pcie_rebind_start;
 static unsigned int brcmf_pcie_rebind_count;
 
@@ -1606,9 +1607,18 @@ static int brcmf_pcie_schedule_rebind(struct pci_dev *pdev)
 	struct brcmf_pcie_rebind *rb;
 	bool give_up = false;
 
+	/* Allocated up front: the work is queued under the lock, so that
+	 * module exit cannot destroy the queue in between.
+	 */
+	rb = kzalloc(sizeof(*rb), GFP_KERNEL);
+	if (!rb)
+		return -ENOMEM;
+	INIT_WORK(&rb->work, brcmf_pcie_rebind_work);
+
 	spin_lock(&brcmf_pcie_rebind_lock);
-	if (brcmf_pcie_rebind_pending) {
+	if (brcmf_pcie_rebind_pending || brcmf_pcie_rebind_closed) {
 		spin_unlock(&brcmf_pcie_rebind_lock);
+		kfree(rb);
 		return 0;
 	}
 	if (!brcmf_pcie_rebind_count ||
@@ -1616,31 +1626,24 @@ static int brcmf_pcie_schedule_rebind(struct pci_dev *pdev)
 		brcmf_pcie_rebind_start = jiffies;
 		brcmf_pcie_rebind_count = 0;
 	}
-	if (brcmf_pcie_rebind_count >= BRCMF_PCIE_REBIND_MAX)
+	if (brcmf_pcie_rebind_count >= BRCMF_PCIE_REBIND_MAX) {
 		give_up = true;
-	else
+	} else {
 		brcmf_pcie_rebind_count++;
-	brcmf_pcie_rebind_pending = !give_up;
+		brcmf_pcie_rebind_pending = true;
+		rb->pdev = pci_dev_get(pdev);
+		if (bus)
+			WRITE_ONCE(bus->quiet, true);
+		queue_work(brcmf_pcie_wq, &rb->work);
+	}
 	spin_unlock(&brcmf_pcie_rebind_lock);
 
 	if (give_up) {
+		kfree(rb);
 		pci_err(pdev, "%u recoveries within %u minutes, giving up; reload brcmfmac or reboot\n",
 			BRCMF_PCIE_REBIND_MAX, BRCMF_PCIE_REBIND_WINDOW / (60 * HZ));
 		return -EBUSY;
 	}
-
-	rb = kzalloc(sizeof(*rb), GFP_KERNEL);
-	if (!rb) {
-		spin_lock(&brcmf_pcie_rebind_lock);
-		brcmf_pcie_rebind_pending = false;
-		spin_unlock(&brcmf_pcie_rebind_lock);
-		return -ENOMEM;
-	}
-	INIT_WORK(&rb->work, brcmf_pcie_rebind_work);
-	rb->pdev = pci_dev_get(pdev);
-	if (bus)
-		WRITE_ONCE(bus->quiet, true);
-	queue_work(brcmf_pcie_wq, &rb->work);
 	return 0;
 }
 
@@ -2991,8 +2994,13 @@ int brcmf_pcie_register(void)
 void brcmf_pcie_exit(void)
 {
 	brcmf_dbg(PCIE, "Enter\n");
-	/* Drain pending recoveries while the driver can still bind. */
+	/* Drain pending recoveries while the driver can still bind; from
+	 * here on brcmf_pcie_schedule_rebind() queues none.
+	 */
 	if (brcmf_pcie_wq) {
+		spin_lock(&brcmf_pcie_rebind_lock);
+		brcmf_pcie_rebind_closed = true;
+		spin_unlock(&brcmf_pcie_rebind_lock);
 		destroy_workqueue(brcmf_pcie_wq);
 		brcmf_pcie_wq = NULL;
 	}
