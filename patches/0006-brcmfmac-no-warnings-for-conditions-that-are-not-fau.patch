From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Weegee <748975+Weegee@users.noreply.github.com>
Date: Tue, 13 Oct 2026 15:21:02 +0200
Subject: [PATCH] brcmfmac: no warnings for conditions that are not faults

Three messages on every probe or disconnect of the MacBook9,1's BCM4350
described no fault:

- 'no clm_blob available, device may have limited channels available':
  firmware 7.35.180.133 has a built-in CLM (clmver 7.9.9) and cannot load
  a blob. The message now stays only when the firmware reports no CLM
  version.
- 'no txcap_blob available': the blob is optional; debug level.
- 'timed out waiting for txstatus' when a flowring is deleted: frames
  still queued in the firmware when the peer goes away get no status;
  the code already deletes the ring regardless. Debug level, with the
  number of outstanding frames.
---
 .../broadcom/brcm80211/brcmfmac/common.c         | 16 +++++++++++++---
 .../broadcom/brcm80211/brcmfmac/msgbuf.c         |  7 ++++++-
 2 files changed, 19 insertions(+), 4 deletions(-)

diff --git a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/common.c b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/common.c
index c4e4140..283f448 100644
--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/common.c
+++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/common.c
@@ -192,8 +192,17 @@ static int brcmf_c_process_clm_blob(struct brcmf_if *ifp)
 
 	err = brcmf_bus_get_blob(bus, &fw, BRCMF_BLOB_CLM);
 	if (err || !fw) {
-		brcmf_info("no clm_blob available (err=%d), device may have limited channels available\n",
-			   err);
+		char clmver[BRCMF_DCMD_SMLEN];
+
+		/* Firmware with a built-in CLM (e.g. BCM4350 7.35.180.133)
+		 * reports its version and needs no blob.
+		 */
+		if (!brcmf_fil_iovar_data_get(ifp, "clmver", clmver,
+					      sizeof(clmver)))
+			brcmf_dbg(INFO, "no clm_blob, firmware has a built-in CLM\n");
+		else
+			brcmf_info("no clm_blob available (err=%d), device may have limited channels available\n",
+				   err);
 		return 0;
 	}
 
@@ -215,7 +224,8 @@ static int brcmf_c_process_txcap_blob(struct brcmf_if *ifp)
 
 	err = brcmf_bus_get_blob(bus, &fw, BRCMF_BLOB_TXCAP);
 	if (err || !fw) {
-		brcmf_info("no txcap_blob available (err=%d)\n", err);
+		/* Optional; most firmware has no use for one. */
+		brcmf_dbg(INFO, "no txcap_blob available (err=%d)\n", err);
 		return 0;
 	}
 
diff --git a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/msgbuf.c b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/msgbuf.c
index 82f09a5..048c9e8 100644
--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/msgbuf.c
+++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/msgbuf.c
@@ -1434,7 +1434,12 @@ void brcmf_msgbuf_delete_flowring(struct brcmf_pub *drvr, u16 flowid)
 		retry--;
 	}
 	if (!retry) {
-		brcmf_err("timed out waiting for txstatus\n");
+		/* Frames the firmware still holds when a peer goes away (at
+		 * disconnect or before suspend) get no status; the ring is
+		 * deleted anyway and the firmware drops them with it.
+		 */
+		brcmf_dbg(MSGBUF, "timed out waiting for txstatus, %d frames outstanding\n",
+			  atomic_read(&commonring_del->outstanding_tx));
 		atomic_set(&commonring_del->outstanding_tx, 0);
 	}
 
