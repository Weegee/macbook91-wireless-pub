#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
#
# macbook91-wireless-verify: is the patched WLAN/Bluetooth stack of
# macbook91-wireless what is actually running on this MacBook9,1?
# Usage, options and exit status: macbook91-wireless-verify --help.
#
# Prints no MAC or Bluetooth addresses, SSIDs or device names.
#
# Text interface (house text HIG, Bash patterns): the report goes to stdout,
# messages to stderr as "macbook91-wireless-verify: error: text". The report
# has no colour, so there is nothing to switch off for NO_COLOR or a pipe.
#
# Abweichung von TXT-5: the verdict words PASS, WARN, FAIL and INFO and the
# final "PASS: 0 FAIL, 0 WARN" line stay. They are quoted by docs/test-status.json,
# the hardware gates in the diagnostics and the owner's gate steps, and scripts
# read them (MAS-2); the word list of the HIG would rename all of them.
set -uo pipefail

PROG=macbook91-wireless-verify
# make install writes the package version here; run from a checkout, the
# version is the one in ../VERSION.
VERSION=@PKGVER@
case $VERSION in @*) VERSION=$(cat "$(dirname "$0")/../VERSION" 2>/dev/null || echo unknown) ;; esac
HOMEPAGE=https://github.com/Weegee/macbook91-wireless-pub

PCI=0000:02:00.0
# The one answer to "is this kernel of a supported series", shared with the
# pacman hook and the install scriptlet.
KERNEL_SERIES=/usr/lib/macbook91-wireless/kernel-series
fails=0
warns=0
pass() { printf 'PASS  %s\n' "$*"; }
warn() { printf 'WARN  %s\n' "$*"; warns=$((warns + 1)); }
fail() { printf 'FAIL  %s\n' "$*"; fails=$((fails + 1)); }
info() { printf 'INFO  %s\n' "$*"; }
has_netdev() { [ -n "$(ls -A /sys/bus/pci/devices/$PCI/net 2>/dev/null)" ]; }

# Messages on stderr (KAN-1, FEH-2): "prog: error: text", hints indented.
err() { printf '%s: error: %s\n' "$PROG" "$1" >&2; shift; [ $# -eq 0 ] || printf '  %s\n' "$@" >&2; }
step() { printf '%s: %s\n' "$PROG" "$*" >&2; } # progress and state changes, one line each
usage_error() {
	err "$@"
	printf 'Usage: %s [--reload]\nRun '"'"'%s --help'"'"' for more\n' "$PROG" "$PROG" >&2
	exit 2
}
plural() { if [ "$1" = 1 ]; then printf '%s %s' "$1" "$2"; else printf '%s %s' "$1" "$3"; fi; }

usage() {
	cat <<USAGE
Usage: $PROG [--reload]

Check that the patched WLAN and Bluetooth drivers of macbook91-wireless are
the ones running on this MacBook9,1. The report has one line per check,
starting with PASS, WARN, FAIL or INFO, and a last line with the totals.

Examples:
  $PROG
  sudo $PROG --reload

Options:
      --reload     load the installed modules now, then check (needs root;
                   WLAN and Bluetooth drop for a few seconds)
  -h, --help       show this help and exit
  -V, --version    show the version and exit

Exit status:
  0  no check failed (warnings do not count)
  1  at least one check failed, or the modules could not be reloaded
  2  invalid usage, or --reload without root

Docs and bug reports: $HOMEPAGE
USAGE
}

# --reload changes state: say what is unloaded and loaded, and what is waited
# for (ERF-2, FOR-2). A cancelled reload may leave the modules unloaded; the
# signal handler says how to load them (SIG-1, SIG-4).
reloading=0
on_signal() { # $1: INT or TERM
	trap - "$1"
	printf '\n%s: cancelled\n' "$PROG" >&2
	[ "$reloading" = 0 ] || printf '  The modules may be unloaded; load them with: sudo modprobe brcmfmac hci_uart\n' >&2
	kill -s "$1" "$$"
}
reload() {
	[ "$(id -u)" = 0 ] || { err "--reload needs root" "Run: sudo $PROG --reload"; exit 2; }
	local m i
	trap 'on_signal INT' INT
	trap 'on_signal TERM' TERM
	step "reloading brcmfmac and hci_uart; WLAN and Bluetooth drop for a few seconds"
	reloading=1
	for m in brcmfmac_wcc brcmfmac_cyw brcmfmac_bca brcmfmac; do
		if grep -q "^$m " /proc/modules; then
			modprobe -r "$m" || { err "cannot unload $m" "See: journalctl -k -b -n 20"; exit 1; }
			step "unloaded $m"
		fi
	done
	modprobe brcmfmac || { err "cannot load brcmfmac" "See: journalctl -k -b -n 20"; exit 1; }
	step "loaded brcmfmac"
	if grep -q '^hci_uart ' /proc/modules; then
		modprobe -r hci_uart || { err "cannot unload hci_uart (in use?)" "Check: lsmod | grep hci_uart"; exit 1; }
		step "unloaded hci_uart"
	fi
	modprobe hci_uart || { err "cannot load hci_uart" "See: journalctl -k -b -n 20"; exit 1; }
	step "loaded hci_uart"
	reloading=0
	# Give the firmware and NetworkManager time to come up before checking.
	step "waiting up to 30 s for the WLAN interface and hci0 (Ctrl+C cancels)"
	for i in $(seq 1 30); do
		has_netdev && [ -e /sys/class/bluetooth/hci0 ] && break
		sleep 1
		[ $((i % 10)) != 0 ] || step "still waiting after $i of 30 s"
	done
	sleep 2
}

# -h, --help and -V, --version win over everything else on the line (HIL-1).
for a in "$@"; do
	case $a in
	--) break ;;
	-h|--help) usage; exit 0 ;;
	-V|--version) printf '%s %s\nLicense: GPL-3.0-or-later\n' "$PROG" "$VERSION"; exit 0 ;;
	esac
done
want_reload=0
while [ $# -gt 0 ]; do
	case $1 in
	--reload) want_reload=1 ;;
	--) shift; break ;;
	-*) usage_error "unknown option: $1" ;;
	*) usage_error "unexpected argument: $1" ;;
	esac
	shift
done
[ $# -eq 0 ] || usage_error "unexpected argument: $1"
[ "$want_reload" = 0 ] || reload

running=$(uname -r)
series=${running%%.*}.$(echo "$running" | cut -d. -f2)
srcdir=$(ls -d /usr/src/macbook91-wireless-* 2>/dev/null | sort -V | tail -n1)

# Package and build ---------------------------------------------------------
if [ -z "$srcdir" ]; then
	fail "macbook91-wireless is not installed (no /usr/src/macbook91-wireless-*); install it with: sudo pacman -S macbook91-wireless-dkms"
	exit 1
fi
# The package carries one source tree per kernel series (KERNEL-SERIES lists
# them); the module identity of the running kernel is the hash of the manifest
# of its series.
pkgver=${srcdir##*/macbook91-wireless-}
want_id="$pkgver+$(sha256sum "$srcdir/series/$series/UPSTREAM.sha256" 2>/dev/null | cut -c1-16)"
info "package $pkgver, running kernel $running"
# A kernel of a series this package does not support runs the stock drivers;
# the module checks below would only say so less clearly.
shipped=0
if [ ! -x "$KERNEL_SERIES" ]; then
	fail "kernel series: $KERNEL_SERIES is missing (reinstall: sudo pacman -S macbook91-wireless-dkms)"
elif msg=$("$KERNEL_SERIES" --kernel "$running" 2>&1); then
	shipped=1
	pass "kernel series: $msg"
else
	# The explanation: a headline, then the sentences that explain it.
	fail "kernel series: $(head -n1 <<<"$msg"). $(tail -n +2 <<<"$msg" | tr '\n' ' ' | sed 's/ $//')"
fi

# Modules: the file depmod resolves and the loaded copy -----------------------
check_module() { # name sysfs-name
	local file tag loaded_src file_src taint
	file=$(modinfo -n "$1" 2>/dev/null)
	tag=$(modinfo -F macbook91_wireless "$1" 2>/dev/null)
	if [ -z "$tag" ]; then
		[ "$shipped" = 1 ] && fail "$1: modprobe resolves to the stock module ($file); DKMS build missing?"
		return
	fi
	[ "$tag" = "$want_id" ] || warn "$1: installed module is $tag, the package sources are $want_id"
	if [ ! -d /sys/module/"$2" ]; then
		warn "$1: not loaded"
		return
	fi
	loaded_src=$(cat /sys/module/"$2"/srcversion 2>/dev/null)
	file_src=$(modinfo -F srcversion "$1" 2>/dev/null)
	taint=$(cat /sys/module/"$2"/taint 2>/dev/null)
	if [ -n "$loaded_src" ] && [ "$loaded_src" = "$file_src" ] && [[ "$taint" == *O* ]]; then
		pass "$1: patched module $tag loaded"
	else
		fail "$1: the loaded module is not the installed patched one (reboot, or: sudo $PROG --reload)"
	fi
}
if [ "$shipped" = 1 ]; then
	if command -v dkms >/dev/null; then
		st=$(dkms status -m macbook91-wireless -v "$pkgver" -k "$running" 2>/dev/null)
		case "$st" in
		*installed*) pass "dkms: built and installed for $running" ;;
		*) fail "dkms: not installed for $running (${st:-no status}); check headers and clang" ;;
		esac
	fi
	check_module brcmfmac brcmfmac
	check_module brcmfmac-wcc brcmfmac_wcc
	check_module hci_uart hci_uart
fi

param() { cat /sys/module/"$1"/parameters/"$2" 2>/dev/null; }
if [ -d /sys/module/brcmfmac/parameters ] && [ -e /sys/module/brcmfmac/parameters/pm_reset ]; then
	[ "$(param brcmfmac pm_reset)" = Y ] && pass "brcmfmac: chip reset across system sleep on" ||
		warn "brcmfmac: pm_reset is off; suspend uses the firmware's own D3 path"
	[ "$(param brcmfmac reset_rebind)" = Y ] && pass "brcmfmac: hang recovery by rebind on" ||
		warn "brcmfmac: reset_rebind is off; a firmware hang needs a manual reload"
fi
# modprobe joins the options of all modprobe.d files in lexical order and the
# last feature_disable wins; bit 0x10 is Wi-Fi P2P.
fd=$(modprobe -c 2>/dev/null | awk '$1 == "options" && $2 == "brcmfmac" {
	for (i = 3; i <= NF; i++) if ($i ~ /^feature_disable=/) v = substr($i, 17) } END {print v}')
if [[ $fd =~ ^(0[xX][0-9a-fA-F]+|[0-9]+)$ ]] && (( fd & 0x10 )); then
	pass "brcmfmac: Wi-Fi P2P off (modprobe.d)"
else
	info "brcmfmac: Wi-Fi P2P on (feature_disable=${fd:-unset} in modprobe.d)"
fi

# Firmware ------------------------------------------------------------------
# brcmfmac loads brcmfmac4350c2-pcie for BCM4350 revisions 0-7 (the
# MacBook9,1 has revision 5) and brcmfmac4350-pcie for later ones.
if ls /usr/lib/firmware/brcm/brcmfmac4350c2-pcie.bin* >/dev/null 2>&1; then
	pass "firmware: brcm/brcmfmac4350c2-pcie.bin present"
else
	fail "firmware: brcm/brcmfmac4350c2-pcie.bin missing (linux-firmware-broadcom)"
fi

# Sleep hooks that fight the driver -----------------------------------------
hooks=$(grep -lsE 'brcmfmac|hci_uart|rfkill' /usr/lib/systemd/system-sleep/* /etc/systemd/system-sleep/* \
	/etc/pm/sleep.d/* /usr/lib/pm-utils/sleep.d/* 2>/dev/null)
units=$(grep -lsE '(modprobe|rmmod).*(brcmfmac|hci_uart)' /etc/systemd/system/*.service \
	/usr/lib/systemd/system/*.service 2>/dev/null)
if [ -n "$hooks$units" ]; then
	for h in $hooks $units; do
		warn "sleep hook touches WLAN/Bluetooth, likely obsolete now: $h"
	done
else
	pass "no sleep hook unloads brcmfmac or hci_uart"
fi

# Devices -------------------------------------------------------------------
if [ -e /sys/bus/pci/devices/$PCI/driver ]; then
	drv=$(basename "$(readlink /sys/bus/pci/devices/$PCI/driver)")
	if [ "$drv" = brcmfmac ] && has_netdev; then
		pass "WLAN: BCM4350 bound to brcmfmac, interface up"
	else
		fail "WLAN: BCM4350 bound to '$drv' but no interface"
	fi
else
	fail "WLAN: BCM4350 ($PCI) has no driver"
fi
if [ -e /sys/class/bluetooth/hci0 ]; then
	soft=$(cat /sys/class/bluetooth/hci0/rfkill*/soft 2>/dev/null | head -n1)
	if [ "$soft" = 1 ]; then
		info "Bluetooth: hci0 present, blocked by rfkill (user setting)"
	else
		pass "Bluetooth: hci0 present"
	fi
else
	fail "Bluetooth: no hci0"
fi

# Journal since the modules were loaded ---------------------------------------
# A module's load time is the last line it logs while loading in this boot:
# brcmfmac registers its USB driver, hci_uart prints its version. Without such
# a line the whole boot counts. (The mtime of /sys/module/<name> is not the
# load time: sysfs stamps a directory when its inode is first looked up.)
since() { # since REGEX: "@<epoch>" of the last kernel line of this boot matching it, or ""
	journalctl -k -b 0 -o short-unix --no-pager 2>/dev/null | grep -E "$1" | tail -n1 |
		awk '{print "@" $1}'
}
kern() { # kern SINCE [journalctl options]: kernel lines of this boot since SINCE ("" = whole boot)
	local args=(-k -b 0 -o cat --no-pager)
	[ -n "$1" ] && args+=(--since "$1")
	journalctl "${args[@]}" "${@:2}" 2>/dev/null
}
if journalctl -k -b 0 -n 1 >/dev/null 2>&1; then
	sw=$(since 'usbcore: registered new interface driver brcmfmac$')
	sb=$(since 'Bluetooth: HCI UART driver ver ')
	when() { [ -z "$1" ] && echo "this boot" || echo "since $(date -d "$1" '+%F %H:%M')"; }
	n_rec=$(kern "$sw" | grep -c 'brcmfmac.*recovering')
	n_giveup=$(kern "$sw" | grep -c 'brcmfmac.*giving up')
	n_werr=$(kern "$sw" -p err | grep -ciE 'brcmf|brcmfmac')
	n_berr=$(kern "$sb" -p err | grep -ciE 'hci0|Bluetooth')
	n_adv=$(kern "$sb" | grep -c 'unknown advertising packet type')
	[ "$n_rec" -gt 0 ] && info "journal: brcmfmac recovered the firmware $(plural "$n_rec" time times) $(when "$sw")"
	[ "$n_giveup" -gt 0 ] && fail "journal: brcmfmac gave up recovering $(when "$sw")"
	[ "$n_werr" -gt 0 ] && warn "journal: $(plural "$n_werr" 'WLAN error line' 'WLAN error lines') $(when "$sw") (see: journalctl -k -b -p err)"
	[ "$n_berr" -gt 0 ] && warn "journal: $(plural "$n_berr" 'Bluetooth error line' 'Bluetooth error lines') $(when "$sb") (see: journalctl -k -b -p err)"
	[ "$n_adv" -gt 0 ] && warn "journal: 'unknown advertising packet type' logged $(plural "$n_adv" time times) $(when "$sb")"
	[ "$n_giveup$n_werr$n_berr$n_adv" = 0000 ] &&
		pass "journal: no WLAN/Bluetooth errors $(when "$sw")"
else
	info "journal: not readable (run as root, or as a member of the group systemd-journal)"
fi

printf '%s: %d FAIL, %d WARN\n' "$([ $fails = 0 ] && echo PASS || echo FAIL)" "$fails" "$warns"
[ "$fails" = 0 ]
